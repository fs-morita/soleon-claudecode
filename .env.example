# 問い合わせフォームの送信先（API Gateway の HTTP API エンドポイント）
# 未設定でもフォームは表示され、送信時に「準備中」の案内が出ます。
# 例) PUBLIC_CONTACT_ENDPOINT="https://xxxx.execute-api.ap-northeast-1.amazonaws.com/contact"
PUBLIC_CONTACT_ENDPOINT=""

# X 自動投稿（ローカルで post.mjs を試すとき。CI では GitHub Secrets を使う）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
