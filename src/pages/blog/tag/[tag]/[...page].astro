---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import { jp } from '../../../../lib/jp';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = (
    await getCollection('articles', ({ data }) => data.draft !== true)
  ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  const tags = [...new Set(articles.flatMap((a) => a.data.tags))];
  return tags.flatMap((tag) =>
    paginate(
      articles.filter((a) => a.data.tags.includes(tag)),
      { params: { tag }, pageSize: 21 }
    )
  );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { tag } = Astro.params;

const pageSuffix =
  page.currentPage > 1 ? `（${page.currentPage}/${page.lastPage}ページ）` : '';
---

<BaseLayout
  title={`「${tag}」の記事一覧${pageSuffix} | 製造業 Claude Code 活用事例集 | SOLEON`}
  description={`「${tag}」に関する製造業のClaude Code / AI活用記事の一覧です。全${page.total}記事。現場ですぐ試せる活用イメージと実装ガイドを掲載しています。`}
>
  <section class="section">
    <div class="container">
      <header class="page-head">
        <nav class="breadcrumb" aria-label="パンくず">
          <a href="/">ホーム</a> <span aria-hidden="true">/</span>
          <a href="/blog">ブログ</a> <span aria-hidden="true">/</span>
          <span class="muted">#{tag}</span>
        </nav>
        <span class="eyebrow">Tag</span>
        <h1 class="jp" set:html={jp(`「${tag}」の記事一覧`)} />
        <p class="lead muted">
          {page.total}記事{page.lastPage > 1 && `（${page.currentPage}/${page.lastPage}ページ）`}
        </p>
      </header>

      <div class="grid grid--3">
        {page.data.map((article) => <ArticleCard article={article} />)}
      </div>

      <Pagination page={page} base={`/blog/tag/${tag}`} />

      <p class="back"><a href="/blog">← ブログ一覧に戻る</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 44rem;
    margin-bottom: 2.4rem;
  }
  .page-head h1 {
    margin: 0 0 0.8rem;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.6rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .back {
    margin-top: 2.5rem;
    font-size: 0.95rem;
  }
</style>
